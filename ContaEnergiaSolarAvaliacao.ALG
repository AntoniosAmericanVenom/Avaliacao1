Algoritmo "conta_Energia_Solar"


Var
   verde,amarelo,vermelho1,vermelho2:inteiro
   consumoMensal,geracaoMensal,tarifaEnergia,taxaFixa:real



Inicio
   verde = 0
   amarelo = 1
   vermelho1 = 2
   vermelho2 = 3
   
   verde <- 0
   amarelo <- 1.885
   vermelho1 <- 4.463
   vermelho2 <- 7.877



Fimalgoritmo